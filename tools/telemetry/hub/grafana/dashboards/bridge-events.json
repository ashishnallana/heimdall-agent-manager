    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "id": 85,
      "panels": [],
      "title": "Events (VictoriaLogs)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "heimdall-victorialogs"
      },
      "description": "LogsQL over the optional VictoriaLogs backend. Lines are rendered by the hub; bridge_id, code, version and the typed fields are structured metadata.",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 86,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "heimdall-victorialogs"
          },
          "expr": "{job=\"heimdall-bridge\"} bridge_id:~\"$bridge_id\" code:~\"$code\" level:~\"$level\"",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Event stream",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "heimdall"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "heimdall-prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "bridge_id",
        "query": "label_values(heimdall_bridge_info, bridge_id)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "name": "level",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "warn",
            "value": "warn"
          },
          {
            "selected": false,
            "text": "error",
            "value": "error"
          }
        ],
        "query": "warn,error",
        "type": "custom"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "heimdall-prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "code",
        "query": "label_values(heimdall_bridge_errors_total, code)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Heimdall / Bridge Events",
  "uid": "heimdall-bridge-events",
  "version": 1
