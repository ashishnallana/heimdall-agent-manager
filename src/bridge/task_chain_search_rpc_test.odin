package main

import "core:testing"

@(test)
task_chain_search_rpc_roundtrip_and_aad_binding :: proc(t: ^testing.T) {
	key_hex := "1111111111111111111111111111111111111111111111111111111111111111"
	aad := task_chain_search_aad("usr_one", "brg_one", "req_one", "request", 1_900_000_000_000)
	defer delete(aad)
	envelope, sealed := task_chain_search_seal(`{"request_id":"req_one","query":"needle"}`, key_hex, aad)
	defer delete(envelope)
	testing.expect(t, sealed, "search request should seal")
	plain, opened := task_chain_search_open(envelope, key_hex, aad, false)
	defer delete(plain)
	testing.expect(t, opened, "matching key and AAD should open")
	testing.expect_value(t, plain, `{"request_id":"req_one","query":"needle"}`)

	wrong_target := task_chain_search_aad("usr_one", "brg_two", "req_one", "request", 1_900_000_000_000)
	defer delete(wrong_target)
	wrong_plain, wrong_opened := task_chain_search_open(envelope, key_hex, wrong_target, false)
	defer delete(wrong_plain)
	testing.expect(t, !wrong_opened, "target Bridge is authenticated by AAD")
}

@(test)
task_chain_search_rpc_rejects_nonce_replay :: proc(t: ^testing.T) {
	key_hex := "2222222222222222222222222222222222222222222222222222222222222222"
	aad := task_chain_search_aad("usr_two", "brg_two", "req_two", "request", 1_900_000_000_000)
	defer delete(aad)
	envelope, sealed := task_chain_search_seal(`{"request_id":"req_two","query":"replay"}`, key_hex, aad)
	defer delete(envelope)
	testing.expect(t, sealed, "fixture should seal")
	first, first_ok := task_chain_search_open(envelope, key_hex, aad, true)
	defer delete(first)
	testing.expect(t, first_ok, "first nonce use should succeed")
	second, second_ok := task_chain_search_open(envelope, key_hex, aad, true)
	defer delete(second)
	testing.expect(t, !second_ok, "second nonce use should be rejected")
}

@(test)
task_chain_search_rpc_opens_browser_webcrypto_vector :: proc(t: ^testing.T) {
	// Generated by sealTaskChainSearch with nonce 000102030405060708090a0b.
	// This pins the WebCrypto/Odin HKDF, AAD, tag layout, and ciphertext contract.
	key_hex := "1111111111111111111111111111111111111111111111111111111111111111"
	aad := task_chain_search_aad("usr_one", "brg_one", "req_one", "request", 1_900_000_000_000)
	defer delete(aad)
	envelope := "search:v1:AAECAwQFBgcICQoLrMPRv9ExeuvvTlVrR5caMnuowFSswj/EbqvFQVBnz8WHndcxMYl8HMlYvt0dxexlNUZH30r7XRtv"
	plain, ok := task_chain_search_open(envelope, key_hex, aad, false)
	defer delete(plain)
	testing.expect(t, ok, "Bridge should open the browser WebCrypto vector")
	testing.expect_value(t, plain, `{"request_id":"req_one","query":"needle"}`)
}
