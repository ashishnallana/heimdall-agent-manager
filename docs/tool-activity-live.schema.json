{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ephemeral tool activity",
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/chain"
    }
  ],
  "$defs": {
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "source",
        "provider_session_id",
        "agent_id",
        "tool_use_id",
        "tool_name",
        "shell_session_id",
        "shell_run_seq",
        "started_at_ms"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "source": {
          "enum": [
            "provider",
            "shell"
          ]
        },
        "provider_session_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "tool_use_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "shell_session_id": {
          "type": "string"
        },
        "shell_run_seq": {
          "type": "integer",
          "minimum": 0
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "source",
        "tool_name",
        "status",
        "duration_ms",
        "completed_at_ms"
      ],
      "properties": {
        "call_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "completed_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instance_id",
        "agent_id",
        "display_name",
        "chain_id",
        "epoch",
        "generation",
        "revision",
        "active",
        "last_completion"
      ],
      "properties": {
        "type": {
          "const": "tool_activity_live"
        },
        "instance_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "chain_id": {
          "type": "string"
        },
        "epoch": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "last_completion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/completion"
            }
          ]
        },
        "stream_epoch": {
          "type": "string"
        },
        "stream_seq": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "instance_id",
        "display_name",
        "snapshot"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "epoch",
        "members"
      ],
      "properties": {
        "chain_id": {
          "type": "string"
        },
        "epoch": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      }
    }
  }
}
