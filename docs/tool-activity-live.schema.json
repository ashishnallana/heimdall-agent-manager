{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demand-driven ephemeral tool activity stream",
  "oneOf": [
    {
      "$ref": "#/$defs/subscribe"
    },
    {
      "$ref": "#/$defs/subscribed"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/unavailable"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/ping"
    },
    {
      "$ref": "#/$defs/pong"
    }
  ],
  "$defs": {
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "source",
        "provider_session_id",
        "agent_id",
        "tool_use_id",
        "tool_name",
        "shell_session_id",
        "shell_run_seq",
        "started_at_ms",
        "summary",
        "summary_truncated"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "maxLength": 2048
        },
        "source": {
          "enum": [
            "provider",
            "shell"
          ]
        },
        "provider_session_id": {
          "type": "string",
          "maxLength": 64
        },
        "agent_id": {
          "type": "string",
          "maxLength": 64
        },
        "tool_use_id": {
          "type": "string",
          "maxLength": 64
        },
        "tool_name": {
          "type": "string",
          "maxLength": 96
        },
        "shell_session_id": {
          "type": "string",
          "maxLength": 64
        },
        "shell_run_seq": {
          "type": "integer",
          "minimum": 0
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "maxLength": 512,
          "x-maxUtf8Bytes": 512,
          "description": "At most512 UTF-8 bytes; cut at a code point boundary."
        },
        "summary_truncated": {
          "type": "boolean"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "source",
        "tool_name",
        "status",
        "duration_ms",
        "completed_at_ms",
        "summary",
        "summary_truncated"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "maxLength": 2048
        },
        "source": {
          "type": "string"
        },
        "tool_name": {
          "type": "string",
          "maxLength": 96
        },
        "status": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "completed_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "maxLength": 512,
          "x-maxUtf8Bytes": 512,
          "description": "At most512 UTF-8 bytes; cut at a code point boundary."
        },
        "summary_truncated": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instance_id",
        "agent_id",
        "display_name",
        "chain_id",
        "epoch",
        "generation",
        "revision",
        "active",
        "bridge_id",
        "availability",
        "run_count",
        "completed_since_last"
      ],
      "properties": {
        "type": {
          "const": "tool_activity_live"
        },
        "instance_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "chain_id": {
          "type": "string"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          },
          "maxItems": 32
        },
        "stream_epoch": {
          "type": "string"
        },
        "stream_seq": {
          "type": "integer",
          "minimum": 0
        },
        "bridge_id": {
          "type": "string",
          "maxLength": 64
        },
        "availability": {
          "const": "ready"
        },
        "run_count": {
          "type": "integer",
          "minimum": 0
        },
        "completed_since_last": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/completion"
          },
          "maxItems": 32,
          "description": "Transient interval batch, oldest dropped on overflow. Empty on baseline; no replay or acknowledgement."
        }
      }
    },
    "subscribe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instance_ids"
      ],
      "properties": {
        "type": {
          "const": "subscribe"
        },
        "instance_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^inst_",
            "maxLength": 64
          }
        }
      }
    },
    "subscribed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instance_ids"
      ],
      "properties": {
        "type": {
          "const": "subscribed"
        },
        "instance_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^inst_",
            "maxLength": 64
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instance_id",
        "baseline",
        "snapshot"
      ],
      "properties": {
        "type": {
          "const": "state"
        },
        "instance_id": {
          "type": "string"
        },
        "baseline": {
          "type": "boolean"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "instance_id",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "unavailable"
        },
        "instance_id": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "bridge_offline",
            "instance_changed",
            "not_found",
            "capacity",
            "state_too_large"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "ping"
        }
      }
    },
    "pong": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "pong"
        }
      }
    }
  }
}
